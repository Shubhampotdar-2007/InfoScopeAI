# InfoScope AI — Frontend Environment Variables
# Copy this file to .env and replace placeholder values with your live configuration.

# Supabase Project Configuration (Find these in your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend FastAPI Service Base URL
VITE_API_BASE_URL=http://localhost:8000
