# InfoScope AI — Backend Environment Variables
# Copy this file to backend/.env and update with your actual credentials.

# Application Settings
PROJECT_NAME="InfoScope AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Supabase Auth / PostgREST Configuration (ES256 via JWKS)
# Found under: Supabase Dashboard -> Project Settings -> API & Auth
SUPABASE_URL="https://your-project-ref.supabase.co"
# Anon/publishable key: used for client requests and PostgREST apikey header
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Legacy fallback key (optional):
SUPABASE_KEY=""
# Service role key (strictly administrative migrations/scripts only, NEVER used for normal user-facing database queries):
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWT_ALGORITHM="ES256"
# Optional overrides (auto-derived from SUPABASE_URL by default):
# SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
# SUPABASE_JWT_ISSUER="https://your-project-ref.supabase.co/auth/v1"

# Web Search Provider Configuration (Tavily Sole Provider)
# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=""

# Search Execution Limits & Timeouts
SEARCH_TIMEOUT_SECONDS=30.0
TAVILY_TIMEOUT_SECONDS=15.0
SEARCH_MAX_RESULTS_PER_PROVIDER=5
SEARCH_MAX_TOTAL_RESULTS=15
