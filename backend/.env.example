# InfoScope AI — Backend Environment Variables
# Copy this file to backend/.env and update with your actual credentials.

# Application Settings
PROJECT_NAME="InfoScope AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Supabase Auth / JWT Configuration
# Found under: Supabase Dashboard -> Project Settings -> API & Auth
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWT_ALGORITHM="HS256"
